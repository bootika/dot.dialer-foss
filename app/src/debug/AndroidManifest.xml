<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Android Auto Calling is currently accepted by Google Play only in Internal/Closed
             testing. Keeping discovery in the debug source set prevents accidental Production
             publication while preserving a complete device/DHU test surface. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />
        <meta-data
            android:name="androidx.car.app.theme"
            android:resource="@style/Theme.DotDialer.Car" />

        <service
            android:name=".auto.DotDialerCarAppService"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:intentMatchingFlags="allowNullAction"
            android:label="@string/app_name"
            android:permission="androidx.car.app.ACCESS_SURFACE"
            tools:targetApi="36">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.CALLING" />
            </intent-filter>
        </service>

        <!-- A managed Telecom provider used only by debug/test APKs. It lets the real
             InCallService UI exercise incoming, outgoing, held and conference calls without
             placing a carrier call. None of these components exist in release APKs. -->
        <service
            android:name=".debug.CallLabConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <activity
            android:name=".debug.CallLabActivity"
            android:exported="true"
            android:label="@string/call_lab_title"
            android:theme="@style/Theme.RillPhone" />

        <receiver
            android:name=".debug.CallLabCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.goodwy.rphone.debug.CALL_LAB" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
